# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀；生产环境由 Nginx 同域反向代理 /api
VITE_API_URL = /

# Delete console
VITE_DROP_CONSOLE = true

# 同源请求也显式带上凭据。面板整站在 nginx 的 HTTP Basic 之后，
# 而 axios 的 XHR 在 withCredentials=false 时被观察到不复用浏览器已缓存的
# Basic 凭据，每个 401 都会再弹一次认证框。
VITE_WITH_CREDENTIALS = true
